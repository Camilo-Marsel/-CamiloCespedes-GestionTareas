generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Enum_Role {
  ADMIN
  USER
}

enum Enum_MovementType {
  ENTRADA
  SALIDA
}

model User {
  id          String     @id @default(cuid())
  name        String
  email       String     @unique
  password    String
  image       String?
  deleted     Boolean    @default(false)
  enabled     Boolean    @default(true)
  role        Enum_Role  @default(USER)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  projects    Project[]
  movements   Movement[]
}

// Maestro = Proyecto
model Project {
  id             String     @id @default(cuid())
  name           String
  initialBalance Float      @default(0)
  deleted        Boolean    @default(false)
  enabled        Boolean    @default(true)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  createdById    String
  createdBy      User       @relation(fields: [createdById], references: [id])
  movements      Movement[]
}

// Transaccion = Movimiento (ENTRADA = tarea asignada, SALIDA = tarea completada)
model Movement {
  id           String            @id @default(cuid())
  type         Enum_MovementType
  quantity     Int
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  projectId    String
  project      Project           @relation(fields: [projectId], references: [id])
  executedById String
  executedBy   User              @relation(fields: [executedById], references: [id])
}
