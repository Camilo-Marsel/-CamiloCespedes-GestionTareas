generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Enum_Role {
  ADMIN
  USER
}

enum Enum_MovementType {
  ENTRADA
  SALIDA
}

enum Enum_TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETION_REQUESTED
  COMPLETED
}

enum Enum_TaskPriority {
  LOW
  MEDIUM
  HIGH
}

enum Enum_NotificationType {
  TASK_ASSIGNED
  COMPLETION_REQUESTED
  TASK_APPROVED
  TASK_REJECTED
}

model User {
  id               String         @id @default(cuid())
  name             String
  email            String         @unique
  password         String
  image            String?
  deleted          Boolean        @default(false)
  enabled          Boolean        @default(true)
  role             Enum_Role      @default(USER)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  projects         Project[]
  movements        Movement[]
  assignedTasks    Task[]         @relation("TaskAssignee")
  createdTasks     Task[]         @relation("TaskCreator")
  approvedTasks    Task[]         @relation("TaskApprover")
  notifications    Notification[]
  chatMessages     ChatMessage[]
}

model Project {
  id             String        @id @default(cuid())
  name           String
  description    String?
  initialBalance Float         @default(0)
  deleted        Boolean       @default(false)
  enabled        Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  createdById    String
  createdBy      User          @relation(fields: [createdById], references: [id])
  movements      Movement[]
  tasks          Task[]
  chatMessages   ChatMessage[]
}

model Movement {
  id           String            @id @default(cuid())
  type         Enum_MovementType
  quantity     Int
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  projectId    String
  project      Project           @relation(fields: [projectId], references: [id])
  executedById String
  executedBy   User              @relation(fields: [executedById], references: [id])
}

model Task {
  id           String            @id @default(cuid())
  title        String
  description  String?
  status       Enum_TaskStatus   @default(PENDING)
  priority     Enum_TaskPriority @default(MEDIUM)
  dueDate      DateTime?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  projectId    String
  project      Project           @relation(fields: [projectId], references: [id])
  assigneeId   String?
  assignee     User?             @relation("TaskAssignee", fields: [assigneeId], references: [id])
  createdById  String
  createdBy    User              @relation("TaskCreator", fields: [createdById], references: [id])
  approvedById String?
  approvedBy   User?             @relation("TaskApprover", fields: [approvedById], references: [id])
  approvedAt   DateTime?
}

model Notification {
  id        String                @id @default(cuid())
  userId    String
  user      User                  @relation(fields: [userId], references: [id])
  type      Enum_NotificationType
  message   String
  read      Boolean               @default(false)
  taskId    String?
  createdAt DateTime              @default(now())
}

model ChatMessage {
  id        String   @id @default(cuid())
  content   String
  projectId String
  project   Project  @relation(fields: [projectId], references: [id])
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  createdAt DateTime @default(now())
}
